# ============================================================
# STATSAKSHAM — Environment Configuration (Supabase & AI)
# ============================================================

# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------
# Option A (Recommended for Supabase): Connection Pooler (Port 6543)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Option B: Direct Connection (Port 5432)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Option C (Default local fallback): SQLite
DATABASE_URL="sqlite:///./statsaksham.db"

# 2. Supabase API Configuration (Optional / For Supabase JS Client & Storage)
# ------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 3. Security
# ------------------------------------------------------------
SECRET_KEY="statsaksham-super-secret-key-sih26101-mospi-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Ollama Local LLM Configuration
# ------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=12
